{
  "extends": "astro/tsconfigs/strict",
  "include": [
    ".astro/types.d.ts",
    "src/**/*",
    "worker-configuration.d.ts"
  ],
  "exclude": [
    "dist",
    "node_modules",
    "experiments",
    "local",
    "work",
    "src/**/*.test.ts",
    "src/**/*.test.tsx"
  ],
  "compilerOptions": {
    "jsx": "preserve",
    "jsxImportSource": "solid-js",
    "types": [
      "@cloudflare/workers-types"
    ],
    "allowImportingTsExtensions": true
  }
}
