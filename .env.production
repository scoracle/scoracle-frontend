# Production env. Vite auto-loads this when `vite build` runs (mode=production).
# Absolute URL → both browser and Cloudflare-Worker server-side fetches resolve
# correctly. wrangler.jsonc has the same value as a runtime binding, but
# import.meta.env.PUBLIC_GO_API_URL is inlined at build time, so this file is
# what the deployed worker actually sees.
PUBLIC_GO_API_URL=https://api.scoracle.com/api/v1
