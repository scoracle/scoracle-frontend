---
import SiteLayout from '../layouts/SiteLayout.astro';
import LeaderboardExplorer from '../islands/LeaderboardExplorer';
import { boardSource, boardLabel, boardCanonical, BOARD_BLURB } from '../lib/utils/board-query';
import { SPORTS } from '../lib/types';
const source = boardSource(key => Astro.url.searchParams.get(key) ?? undefined);
const sport = source.sport();
const sportName = SPORTS.find(item => item.idLower === sport)!.display;
---
<SiteLayout title={`${sportName} ${boardLabel(source)} Leaderboard · Scoracle`} description={BOARD_BLURB[source.board()]} canonical={boardCanonical(source)} page="leaderboard" mainClass="lb-main" sport={sport}>
  <LeaderboardExplorer initialSearch={Astro.url.search} client:load />
  <noscript>Live boards require JavaScript. Use the navigation to explore Scoracle.</noscript>
</SiteLayout>
