{
  "name": "scoracle-frontend",
  "version": "0.1.0",
  "type": "module",
  "private": true,
  "description": "Scoracle flagship frontend — Astro and stable Solid on Cloudflare Workers",
  "license": "UNLICENSED",
  "engines": {
    "node": ">=22.23.4"
  },
  "scripts": {
    "test:watch": "NODE_OPTIONS=--no-experimental-webstorage vitest",
    "sync:assets": "node scripts/sync-token-assets.mjs",
    "check:assets": "node scripts/sync-token-assets.mjs --check",
    "fetch-data": "node scripts/generate-sitemap.mjs",
    "gen:sitemap": "node scripts/generate-sitemap.mjs",
    "cf:tail": "wrangler tail",
    "test:browser": "playwright test",
    "dev": "node scripts/build-hero-webp.mjs && astro dev --host 127.0.0.1",
    "dev:stop": "astro dev stop",
    "build": "node scripts/build-hero-webp.mjs && astro build && npm run verify:build",
    "preview": "astro preview --host 127.0.0.1 --port 4322",
    "preview:stop": "astro preview stop",
    "typecheck": "astro check",
    "test": "NODE_OPTIONS=--no-experimental-webstorage vitest run && npm run test:runtime",
    "test:runtime": "node --conditions=browser --experimental-strip-types --test tests/runtime/*.test.ts",
    "verify:build": "node tests/runtime/build.mjs",
    "verify:ssr": "node tests/runtime/preview.mjs",
    "cf:build": "npm run build",
    "cf:types": "wrangler types --include-runtime=false",
    "cf:deploy:dry": "npm run build && wrangler deploy --dry-run"
  },
  "dependencies": {
    "@astrojs/cloudflare": "14.4.7",
    "@astrojs/solid-js": "7.1.5",
    "astro": "7.4.12",
    "solid-js": "1.9.19",
    "@scoracle/tokens": "file:../scoracle-tokens"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "5.20261112.1",
    "@testing-library/dom": "^10.4.1",
    "happy-dom": "21.0.4",
    "sharp": "0.35.5",
    "typescript": "5.9.3",
    "vitest": "4.1.12",
    "wrangler": "4.161.0",
    "@playwright/test": "1.63.0",
    "@astrojs/check": "0.9.12",
    "vite-plugin-solid": "2.11.16"
  }
}
