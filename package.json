{
  "name": "scoracle-frontend",
  "version": "0.1.0",
  "type": "module",
  "private": true,
  "description": "Scoracle flagship frontend — greenfield SolidStart 2.0-alpha + Solid 1.9.11",
  "license": "UNLICENSED",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "vite dev",
    "build": "vite build",
    "start": "node .output/server/index.mjs",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "sync:assets": "node scripts/sync-token-assets.mjs",
    "check:assets": "node scripts/sync-token-assets.mjs --check",
    "postinstall": "node scripts/copy-og-wasm.mjs",
    "fetch-data": "node scripts/fetch-autofill.mjs",
    "cf:deploy": "vite build && wrangler deploy",
    "cf:deploy:dry": "vite build && wrangler deploy --dry-run",
    "cf:dev": "vite build && wrangler dev",
    "cf:tail": "wrangler tail"
  },
  "dependencies": {
    "@fontsource/pt-serif": "^5.2.8",
    "@nanostores/solid": "^1.1.1",
    "@resvg/resvg-wasm": "^2.6.2",
    "@scoracle/tokens": "^0.6.0",
    "@solidjs/meta": "^0.29.4",
    "@solidjs/router": "^0.16.1",
    "@solidjs/start": "2.0.0-alpha.2",
    "nanostores": "^1.2.0",
    "solid-js": "1.9.11",
    "solid-transition-group": "^0.3.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20260426.1",
    "@solidjs/testing-library": "^0.8.10",
    "@testing-library/dom": "^10.4.1",
    "happy-dom": "^20.9.0",
    "sharp": "^0.34.5",
    "typescript": "^5.9.3",
    "vite": "^7.0.0",
    "vitest": "^4.1.5",
    "wrangler": "^4.77.0"
  },
  "overrides": {
    "h3": "2.0.1-rc.18",
    "srvx": "^0.11.13"
  }
}
