# Cloudflare Workers Static Assets — cache headers per path.
# Vite-built assets are content-hashed (foo.abc123.js) so they're safe to
# cache forever. Bundled JSON snapshots refresh every deploy via the
# __DATA_VERSION__ define, so a 1-day max-age + week-long SWR is plenty
# (browsers serve stale instantly, revalidate in the background).

/_build/*
  Cache-Control: public, max-age=31536000, immutable

/data/*
  Cache-Control: public, max-age=86400, stale-while-revalidate=604800

/images/*
  Cache-Control: public, max-age=604800

# Vendored brand fonts change only on a deliberate re-vendor (new filename
# would ride along), so cache hard.
/fonts/*
  Cache-Control: public, max-age=31536000, immutable

# The favicon's version lives in its FILENAME (favicon-N.svg): the Workers
# asset cache keys on pathname only, so a `?v=` query cannot bust the edge.
# The unversioned /favicon.svg remains for clients that request it blindly;
# it gets a short TTL so a redesign eventually reaches them too.
/favicon-3.svg
  Cache-Control: public, max-age=31536000, immutable

/favicon-2.svg
  Cache-Control: public, max-age=31536000, immutable

/favicon.svg
  Cache-Control: public, max-age=86400
