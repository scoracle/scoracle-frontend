{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "scoracle-frontend",
  "main": "./worker.ts",
  "compatibility_date": "2026-03-17",
  "compatibility_flags": ["nodejs_compat"],

  // Static Assets — Vite's `dist/client/` becomes the asset bundle. With
  // `run_worker_first: true`, the worker decides routing: it forwards
  // recognized asset prefixes to env.ASSETS and falls through to SolidStart
  // SSR for everything else.
  "assets": {
    "directory": "./dist/client",
    "binding": "ASSETS",
    "run_worker_first": true,
    "not_found_handling": "none"
  },

  // Single source of truth for PUBLIC_GO_API_URL.
  // Even though the Worker doesn't read this at runtime (Vite inlines it
  // into both client + server bundles at build time via envPrefix), keeping
  // it here makes the deployment surface complete and matches the pattern
  // the legacy Astro Worker uses. To change the production API URL, edit
  // this line and commit.
  "vars": {
    "PUBLIC_GO_API_URL": "https://api.scoracle.com/api/v1"
  },

  "observability": {
    "enabled": true
  }
}
