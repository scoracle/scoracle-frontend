---
import AppTray, { type RecentEntity } from '../islands/AppTray';
import Footer from '../components/Footer.astro';
import PageAtmosphere from '../components/PageAtmosphere.astro';
import type { TeamPalette } from '../../../src/lib/utils/team-colors';
import '../../../src/global.css';
interface Props { title: string; description?: string; canonical?: string; page: string; mainClass?: string; sport?: string; entity?: RecentEntity; palette?: TeamPalette; }
const { title, description = 'Sports intelligence for NBA, NFL, and Football — stats, news, social sentiment, and AI-powered insights on every player and team.', canonical = Astro.url.pathname, page, mainClass, sport, entity, palette } = Astro.props;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="format-detection" content="telephone=no" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={new URL(canonical, Astro.site)} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Scoracle" />
    <meta property="og:url" content={new URL(canonical, Astro.site)} />
    <meta property="og:image" content="https://scoracle.com/images/brand-unfurl.png" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:image" content="https://scoracle.com/images/brand-unfurl.png" />
    <slot name="head" />
    <link rel="icon" href="/favicon-6.svg" type="image/svg+xml" />
    <link rel="preload" href="/fonts/fraunces-var.woff2" as="font" type="font/woff2" crossorigin />
    <script is:inline>(function(){var t;try{t=localStorage.getItem('scoracle-theme');}catch(e){}if(t==='dark'||(t!=='light'&&matchMedia('(prefers-color-scheme: dark)').matches)){document.documentElement.classList.add('dark');}})();</script>
  </head>
  <body>
    <div id="app">
      <AppTray pathname={Astro.url.pathname} sport={sport} entity={entity} client:load />
      <main class={mainClass}>
        {['home', 'profile', 'leaderboard'].includes(page) && <PageAtmosphere palette={palette} />}
        <slot />
      </main>
      <Footer />
    </div>
  </body>
</html>
