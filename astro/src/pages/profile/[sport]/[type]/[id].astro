---
import { env } from 'cloudflare:workers';
import SiteLayout from '../../../../layouts/SiteLayout.astro';
import ProfileExperience from '../../../../islands/ProfileExperience';
import { parseProfilePath, profilePath } from '../../../../../../src/lib/utils/profile-url';
import { resolveFromMaps } from '../../../../../../src/lib/data/entity-meta';
import type { PlayerMeta, TeamMeta } from '../../../../../../src/lib/types';
const parts = parseProfilePath(Astro.url.pathname);
if (!parts) return Astro.rewrite('/404');
let maps;
try {
  const response = await env.ASSETS.fetch(new URL(`/data/${parts.sport}-meta.json`, Astro.url));
  // Failed assets must surface as server failures, never false missing identities.
  if (!response.ok) throw new Error('Identity unavailable');
  const data = await response.json() as { players: PlayerMeta[]; teams: TeamMeta[] };
  maps = {
    players: Object.fromEntries(data.players.map(item => [String(item.id), item])),
    teams: Object.fromEntries(data.teams.map(item => [String(item.id), item])),
  };
} catch {
  return new Response('Identity unavailable', { status: 503, headers: { 'Cache-Control': 'no-store' } });
}
const identity = resolveFromMaps(maps, parts.sport, parts.type, parts.id);
if (!identity) return Astro.rewrite('/404');
const canonical = profilePath(parts.sport, parts.type, parts.id, { name: identity.name });
---
<SiteLayout title={`${identity.name} — Scoracle`} page="profile" canonical={canonical}>
  <h1>{identity.name}</h1><p>{identity.subtitle}</p>
  <ProfileExperience {...parts} name={identity.name} initialSearch={Astro.url.search} client:load />
</SiteLayout>
